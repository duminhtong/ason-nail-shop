// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN") // Only admins for now
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?          @db.Text
  costPrice       Float            // 1688 price in CNY
  sellingPrice    Float            // Converted & marked up price in VND
  originalPrice   Float?           // For psychological pricing (VND)
  profitMargin    Float            // Percentage
  sourceLink      String?          // 1688 URL
  notes           String?          @db.Text // Private admin notes
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  isTrending      Boolean          @default(false)
  isNew           Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id        String   @id @default(cuid())
  name      String   // e.g. "Color", "Size"
  value     String   // e.g. "Red", "XL"
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Float?   // Optional variant-specific price override
  createdAt DateTime @default(now())
}

model PricingRule {
  id         String   @id @default(cuid())
  name       String   // e.g. "Global Multiplier", "Exchange Rate"
  key        String   @unique // e.g. "GLOBAL_MULTIPLIER", "CNY_TO_VND"
  value      Float
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  contact   String
  product   String
  note      String?  @db.Text
  createdAt DateTime @default(now())
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "BRAND_NAME", "HERO_TITLE", "HERO_SUBTITLE"
  value     String   @db.Text
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
